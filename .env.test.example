# Local Docker test configuration. Copy this file to .env.test.
# These credentials match the repository's compose.yaml service.
APP_ENV=test
DATABASE_URL=postgresql://cdss:cdss@localhost:54321/cdss_test
TEST_DATABASE_URL=postgresql://cdss:cdss@localhost:54321/cdss_test
TEST_DATABASE_NAME=cdss_test
ALLOW_DESTRUCTIVE_TEST_DB=true

# Destructive Alembic tests use a separate empty database in the same container.
SCHEMA_TEST_DATABASE_URL=postgresql://cdss:cdss@localhost:54321/cdss_schema_test
SCHEMA_TEST_DATABASE_NAME=cdss_schema_test

# Any configured non-test database name is rejected by the safety guard.
DEVELOPMENT_DATABASE_NAME=cdss
STAGING_DATABASE_NAME=
PRODUCTION_DATABASE_NAME=
