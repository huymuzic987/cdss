      "T3_INFERENCE_SET_AGE_70_OR_HIGHER_BP_TARGET": {
        "id": "c9e3529b-2291-4756-1e9c-13b00c5fdd0f",
        "node_key": "T3_INFERENCE_SET_AGE_70_OR_HIGHER_BP_TARGET",
        "node_type": "INFERENCE",
        "text_en": "Target SBP <140 mmHg, or <130 mmHg if tolerated\nTarget DBP <80 mmHg",
        "text_vi": "Đích điều trị HATT <140 hoặc <130 nếu dung nạp được\nĐích điều trị HATTr <80",
        "condition_definition": null,
        "context_patch": {
          "treatment": {
            "bp_target": {
              "dbp": {
                "upper_exclusive_mmhg": 80
              },
              "sbp": {
                "upper_exclusive_mmhg": 140,
                "preferred_upper_exclusive_if_tolerated_mmhg": 130
              },
              "source": "TREE_3_GENERIC"
            }
          },
          "orchestration": {
