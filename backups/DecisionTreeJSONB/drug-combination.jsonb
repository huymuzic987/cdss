      "T6_C_SPECIAL_POPULATION": {
        "id": "b671f1b7-c554-49f0-b066-a7adc4deabda",
        "node_key": "T6_C_SPECIAL_POPULATION",
        "node_type": "CONDITION",
        "text_en": "Persistent high-normal BP after lifestyle management, age 80 or older, or frailty syndrome",
        "text_vi": "HABTC không đạt mục tiêu sau thay đổi lối sống hoặc tuổi >= 80 hoặc hội chứng lão hóa",
        "condition_definition": {
          "any": [
            {
              "op": "eq",
              "path": "input.is_lifestyle_follow_up",
              "value": true
            },
            {
              "op": "gte",
              "path": "input.age",
              "value": 80
            },
            {
              "op": "eq",
              "path": "input.has_frailty_syndrome",
              "value": true
            }
          ]
        },
        "context_patch": null,
