# Copy to .env and adjust. DATABASE_URL is read from the environment only.

# One of: development | test | production
APP_ENV=development

# psycopg2 driver URL (matches compose.yaml credentials)
DATABASE_URL=postgresql://cdss:cdss@localhost:54321/cdss

# Safe upper bound for traversal across all linked trees.
CDSS_MAX_STEPS=300

# Opt-in process-level caching of immutable tree graphs. Off by default.
# Enable only if you invalidate the cache (restart/clear) after re-seeding trees.
# CDSS_GRAPH_CACHE_ENABLED=false

# Defaults to true in development/test and false in production when unset.
# Leave commented to use the environment-derived default.
# DEV_RUNTIME_LOGGING_ENABLED=true
