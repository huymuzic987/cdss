# Template for the production .env consumed by docker-compose.prod.yml.
# Store the filled-in version as the "cdss-prod-env" Jenkins secret file
# credential referenced by the Jenkinsfile - do not commit a filled-in copy.
#
# DATABASE_URL is deliberately not set here: docker-compose.prod.yml builds
# it internally from the POSTGRES_* values below so it always points at the
# in-network db service.

APP_ENV=production

# Safe upper bound for traversal across all linked trees.
CDSS_MAX_STEPS=300

# Provisions the db container and is used to build the backend's
# DATABASE_URL. Change POSTGRES_PASSWORD before first deploy.
POSTGRES_USER=cdss
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cdss

# Public host port the frontend (nginx) container is published on.
APP_PORT=3000
